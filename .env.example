# Copia este archivo como `.env` y reemplaza los valores entre <>.

# --- Desarrollo (Postgres en Docker, ver docker-compose.yml) ---
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/football_players?schema=public"

# --- Pruebas de integración (pnpm test) ---
# Base separada que las pruebas crean y vacían. Debe estar en localhost y terminar en _test.
TEST_DATABASE_URL="postgresql://<user>:<password>@localhost:5432/football_players_test?schema=public"

# --- Autenticación (Better Auth) ---
# Secreto para firmar las cookies de sesión (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Usa un valor distinto en cada entorno y no lo compartas.
BETTER_AUTH_SECRET="<secreto-aleatorio>"
# URL pública de la aplicación. En Vercel es opcional: si falta, se usa la URL del despliegue.
BETTER_AUTH_URL="http://localhost:3000"

# Usuario demo (solo lectura). El botón «Entrar como demo» inicia la sesión en el
# servidor con estas credenciales; nunca llegan al navegador. Mínimo 8 caracteres.
DEMO_EMAIL="<correo-demo>"
DEMO_PASSWORD="<contraseña-demo>"

# Usuario administrador. Solo las lee `pnpm db:usuarios` para crearlo o cambiar su
# contraseña; la aplicación no las necesita en ejecución (no hace falta ponerlas en Vercel).
# Mínimo 12 caracteres.
ADMIN_EMAIL="<correo-admin>"
ADMIN_PASSWORD="<contraseña-admin>"

# --- Producción (Neon) ---
# Conexión con pooling (host con "-pooler"), usada por la aplicación en tiempo de ejecución:
# DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
# Conexión directa (host sin "-pooler"), usada por la CLI de Prisma para migraciones:
# DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require"
