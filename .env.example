# Copia este archivo como `.env` y reemplaza los valores entre <>.

# --- Desarrollo (Postgres en Docker, ver docker-compose.yml) ---
# Contraseña del Postgres local. Elige una; docker compose no arranca sin ella.
POSTGRES_PASSWORD="<password>"
# Usa la misma contraseña en la URL.
DATABASE_URL="postgresql://football:<password>@localhost:5432/football_players?schema=public"

# --- Producción (Neon) ---
# Conexión con pooling (host con "-pooler"), usada por la aplicación en tiempo de ejecución:
# DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
# Conexión directa (host sin "-pooler"), usada por la CLI de Prisma para migraciones:
# DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require"
