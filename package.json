    "better-auth": "^1.7.22",
    "lucide-react": "^1.61.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
